# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own values. Never commit .env.
# ---------------------------------------------------------------------------

# Solana RPC endpoint. Public endpoints (api.mainnet-beta.solana.com) are
# rate-limited and NOT reliable for log subscriptions / sniping. Use a
# dedicated provider (Helius, QuickNode, Triton, etc).
RPC_URL=https://api.mainnet-beta.solana.com

# Optional: a separate websocket endpoint if your provider issues one.
# If omitted, @solana/web3.js derives a wss:// URL from RPC_URL automatically.
WS_URL=

# Only required once trading is enabled (config/default.json -> trading.enabled).
# Base58-encoded secret key of the trading wallet. KEEP THIS OUT OF GIT.
WALLET_PRIVATE_KEY=

# minimal | info | debug
LOG_LEVEL=info
