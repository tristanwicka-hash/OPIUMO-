# Copy this file to .env and fill in real values. NEVER commit .env.
# .env is already listed in .gitignore.

# --- Solana RPC ---
# Use a paid/private RPC provider for real-time work (Helius or QuickNode
# recommended). Free public RPCs will rate-limit and drop websocket
# subscriptions under load.
#   Helius:    https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#              wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#   QuickNode: https://your-endpoint.solana-mainnet.quiknode.pro/YOUR_KEY/
#              wss://your-endpoint.solana-mainnet.quiknode.pro/YOUR_KEY/
SOLANA_RPC_HTTP_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS_URL=wss://api.mainnet-beta.solana.com

# --- Wallet ---
# Base58-encoded secret key (the format Phantom/Solflare export, and what
# `solana-keygen` prints). This must be a DEDICATED HOT WALLET funded only
# with what you're willing to risk on this bot. Never reuse a main wallet.
# Never commit this value or paste it anywhere but this local .env file.
WALLET_PRIVATE_KEY=

# --- Live-trading safety interlock ---
# The bot will NEVER place a real trade unless ALL of the following are
# true at once:
#   1) config/config.yaml -> mode: "live"
#   2) the process is started with the --live CLI flag
#   3) this env var is exactly YES
# Leave this blank (or anything other than YES) to keep the bot in
# scan-only mode no matter what else is set.
CONFIRM_LIVE_TRADING=
