# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own values. Never commit .env.
# ---------------------------------------------------------------------------

# Solana RPC endpoint. Public endpoints (api.mainnet-beta.solana.com) are
# rate-limited and NOT reliable for log subscriptions / sniping. Use a
# dedicated provider (Helius, QuickNode, Triton, etc).
RPC_URL=https://api.mainnet-beta.solana.com

# Optional: a separate websocket endpoint if your provider issues one.
# If omitted, @solana/web3.js derives a wss:// URL from RPC_URL automatically.
WS_URL=

# Required once trading.enabled OR perps.enabled is true (config/default.json) -
# also required just to READ your Drift account (perps test:perps-connection needs it
# even with perps.enabled=false). Base58-encoded secret key. KEEP THIS OUT OF GIT.
# For perps: start with a throwaway keypair and config/default.json perps.env=devnet
# (free devnet SOL from a faucet) - do NOT point your real wallet at mainnet-beta
# until you've read src/perps/risk.ts and tested on devnet first.
WALLET_PRIVATE_KEY=

# minimal | info | debug
LOG_LEVEL=info
