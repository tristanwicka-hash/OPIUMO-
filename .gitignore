node_modules/
dist/
.env
logs/*.log
logs/*.jsonl
logs/*.json
!logs/.gitkeep
# Test scratch directories. Suites write freely inside their own logs/test-*/
# folder - that is what keeps them out of the production logs - so the contents
# change on every run. logs/test-filters/decisions.jsonl was tracked by
# accident and showed up as a modified file in every commit once the
# pre-commit hook started running suites before each one.
logs/test-*/
data/*.jsonl
!data/.gitkeep
*.log
.DS_Store

# Generated performance reports - contain P&L, and this repo is public
reports/*
!reports/.gitkeep

# Obsidian vault - private notes, never commit (this repo is public).
# The vault normally lives OUTSIDE this repo; these patterns are a backstop
# for the day someone copies or moves it in. It has been renamed several
# times, so every name it has had is listed - a pattern with a space still
# works here, and needs no escaping.
vault/
Vault/
Tristan Vault/
Tristans Vault/
.obsidian/

# Credential-shaped files: never tracked, in any repo. Checked by
# hooks/pre-push-scan.sh before anything is pushed to a remote.
.env
.env.*
!.env.example
.env.local
tokens.json
accounts.json
credentials.json
*.pem
*.key
id_rsa*
.npmrc

# Logs are not source. This one was tracked by accident and carried public
# chain signatures into a public repo - not a secret, but not source either.
logs/archive/
